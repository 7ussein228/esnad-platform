# Database (required — Vercel Postgres / Neon / Supabase)
# For Neon use ?sslmode=verify-full to avoid pg driver warnings
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# App URL (used for metadata + Firebase authorized domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fixed single-teacher account (seeded via `npm run db:seed` — override in production)
TEACHER_EMAIL=teacher@esnad.com
TEACHER_PASSWORD=change-me-strong-password
TEACHER_NAME=مستر المنصة

# Firebase Web (get from Firebase Console → Project Settings → Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin (secure server verification — service account JSON stringified)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Storage (optional — S3 / R2 / Spaces; falls back to public/uploads locally)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
